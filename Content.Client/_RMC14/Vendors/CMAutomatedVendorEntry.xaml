<cc:CMAutomatedVendorEntry
    xmlns="https://spacestation14.io"
    xmlns:cc="clr-namespace:Content.Client._RMC14.Vendors"
    HorizontalExpand="True">
    <!-- CCM: vendor UI refresh -->
    <BoxContainer Orientation="Horizontal" SeparationOverride="6" VerticalAlignment="Center">
        <PanelContainer Name="IconFrame" Access="Public" SetSize="42 42">
            <LayeredTextureRect Name="Texture" Access="Public"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                HorizontalExpand="False"
                                VerticalExpand="False" />
        </PanelContainer>
        <PanelContainer Name="AmountFrame" Access="Public" MinWidth="34">
            <Label Name="Amount" Access="Public" Align="Center" Margin="6 3" />
        </PanelContainer>
        <cc:CMAutomatedVendorPanel Name="Panel" Access="Public" />
        <PanelContainer Name="TooltipFrame" Access="Public" SetSize="20 20">
            <Label Name="TooltipLabel" Access="Public" Text="?" Align="Center" />
        </PanelContainer>
    </BoxContainer>
</cc:CMAutomatedVendorEntry>
