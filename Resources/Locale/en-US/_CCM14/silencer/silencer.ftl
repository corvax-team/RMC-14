# Silencer — acoustic carbine
ccm-silencer-hive-disrupted = A piercing shriek drowns out the hive! You can't hear your sisters!
ccm-silencer-hive-restored = The ringing fades. You can hear the hive again.
ccm-silencer-hive-cant-speak = The ringing in your head drowns out the hivemind!

# Silencer — "Impulse" underbarrel
ccm-silencer-pulse-knockdown = A crushing wave of sound throws you off your feet!
ccm-silencer-pulse-slow = A wall of ultrasound makes you stagger!

# Silencer — "Echo" jammer pack
ccm-silencer-echo-on = The "Echo" jammer hums to life, flooding the area with white noise.
ccm-silencer-echo-off = You switch the "Echo" jammer off.
ccm-silencer-echo-not-worn = The "Echo" jammer has to be worn on your back.
ccm-silencer-echo-no-charge = The "Echo" jammer has no charge!
ccm-silencer-echo-depleted = The "Echo" jammer's power cell is depleted. It shuts down.
ccm-silencer-echo-examine-on = It is [color=green]active[/color].
ccm-silencer-echo-examine-off = It is [color=red]inactive[/color].
ccm-silencer-echo-examine-charge = Charge: [color=yellow]{ $percent }%[/color] (~{ $time } of jamming).
ccm-silencer-echo-examine-no-cell = It has [color=red]no power cell[/color].

# Silencer — specialist
ccm-silencer-unskilled = You don't know how to use { THE($item) }.
ccm-job-name-weapons-specialist-silencer = Silencer Specialist
ccm-job-prefix-weapons-specialist-silencer = SIL
