uniform highp float visibility;
uniform highp float noise_strength;

void fragment() {
    highp vec4 sprite = zTexture(UV);

    if (sprite.a == 0.0 || visibility <= 0.0) {
        discard;
    }

    highp vec2 cell = floor(FRAGCOORD.xy / 2.0);
    highp float frame = floor(TIME * 24.0);
    highp float noise = zRandom(cell + vec2(frame * 13.0, frame * 7.0)).x * 0.5 + 0.5;

    highp float band = step(0.85, fract(FRAGCOORD.y * 0.02 - TIME * 1.3));

    highp float value = clamp(noise * 0.75 + band * 0.35, 0.0, 1.0);
    highp vec3 color = mix(sprite.rgb, vec3(value), clamp(noise_strength, 0.0, 1.0));
    COLOR = vec4(color, sprite.a * visibility);
}
